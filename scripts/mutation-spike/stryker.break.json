{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --experimental-strip-types --test scripts/mutation-spike/weak.test.mts"
  },
  "mutate": ["scripts/mutation-spike/label.mts"],
  "reporters": ["clear-text"],
  "ignorePatterns": [".cursor", ".playwright-browsers", "playwright-report", "test-results", "ai-reports", "notes"],
  "coverageAnalysis": "off",
  "concurrency": 1,
  "thresholds": { "high": 100, "low": 100, "break": 100 }
}
