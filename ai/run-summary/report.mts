import { escapeMarkdown } from '../shared/markdown.mts';
import { code, dataTable, escapeHtml, htmlPage, muted, section, statTiles } from '../shared/html.mts';
import type { RunSummaryReport, SuiteRunSummary } from './types.mts';

/**
 * Inline code for text from the page (untrusted): one line, at most 200 characters, and a fence
 * longer than any backtick run inside, so it can't close the code span early.
 */
function inlineCode(raw: string): string {
  const flat = raw.replace(/\s+/g, ' ').trim();
  const value = flat.length > 200 ? `${flat.slice(0, 199)}…` : flat;
  const longest = Math.max(0, ...(value.match(/`+/g) ?? []).map((run) => run.length));
  const fence = '`'.repeat(longest + 1);
  const pad = value.startsWith('`') || value.endsWith('`') ? ' ' : '';
  return `${fence}${pad}${value}${pad}${fence}`;
}

function statusEmoji(status: SuiteRunSummary['status'] | RunSummaryReport['overallStatus']): string {
  switch (status) {
    case 'passed':
      return '✅';
    case 'failed':
      return '❌';
    case 'flaky':
      return '⚠️';
    case 'skipped':
      return '⏭️';
    default:
      return '▫️';
  }
}

function formatSuiteSection(suite: SuiteRunSummary): string {
  const lines: string[] = [
    `### ${statusEmoji(suite.status)} \`${escapeMarkdown(suite.suite)}\``,
    '',
    `| Metric | Count |`,
    `|---|---|`,
    `| expected | ${suite.stats.expected} |`,
    `| unexpected | ${suite.stats.unexpected} |`,
    `| flaky | ${suite.stats.flaky} |`,
    `| skipped | ${suite.stats.skipped} |`,
    '',
  ];

  if (suite.hardFailures.length > 0) {
    lines.push('**Hard failures**', '');
    for (const failure of suite.hardFailures) {
      const error = failure.lastError ? ` — \`${escapeMarkdown(failure.lastError)}\`` : '';
      lines.push(`- **${escapeMarkdown(failure.category)}:** ${escapeMarkdown(failure.fullTitle)}${error}`);
      lines.push(`  - file: \`${escapeMarkdown(failure.file)}\``);
      if (failure.locator) {
        const hint = failure.locator;
        lines.push(
          `  - suggested locator (similarity ${hint.score.toFixed(2)}, ${hint.confidence}; review, not applied): ` +
            `${inlineCode(hint.suggested)} instead of ${inlineCode(hint.failed)}`,
        );
      }
    }
    lines.push('');
  }

  if (suite.flakyTests.length > 0) {
    lines.push('**Flaky tests**', '');
    for (const title of suite.flakyTests) {
      lines.push(`- ${escapeMarkdown(title)}`);
    }
    lines.push('');
  }

  if (suite.hardFailures.length === 0 && suite.flakyTests.length === 0) {
    lines.push('_No hard failures or flaky tests._', '');
  }

  return lines.join('\n');
}

/**
 * Compact Markdown suitable for GitHub PR comments and local review.
 */
export function generateRunSummaryMarkdown(report: RunSummaryReport): string {
  const lines: string[] = [
    `## ${report.title}`,
    '',
    `${statusEmoji(report.overallStatus)} **Overall:** \`${report.overallStatus}\` · Generated ${report.generatedAt}`,
    '',
    '### Totals',
    '',
    '| Suite metric | Count |',
    '|---|---|',
    `| expected | ${report.totals.expected} |`,
    `| unexpected | ${report.totals.unexpected} |`,
    `| flaky | ${report.totals.flaky} |`,
    `| skipped | ${report.totals.skipped} |`,
    '',
  ];

  if (report.suites.length === 0) {
    lines.push('_No suite reports were provided._', '');
    return `${lines.join('\n')}\n`;
  }

  lines.push('### Suites', '');
  for (const suite of report.suites) {
    lines.push(formatSuiteSection(suite));
  }

  lines.push(
    '---',
    '',
    '_Generated by `npm run analyze:summary` (flaky detector + failure classifier)._',
    '',
  );

  return `${lines.join('\n')}\n`;
}

export function defaultSummaryOutPath(format: 'md' | 'html' = 'md'): string {
  return `ai-reports/run-summary.${format}`;
}

const STATUS_TONE: Record<RunSummaryReport['overallStatus'], string> = {
  passed: 'good',
  failed: 'bad',
  flaky: 'warn',
  skipped: 'neutral',
  empty: 'neutral',
};

function htmlSuite(suite: SuiteRunSummary): string {
  const failures =
    suite.hardFailures.length === 0
      ? ''
      : `<h4>Hard failures</h4>
      ${dataTable(
        ['Cause', 'Test', 'Error'],
        suite.hardFailures.map((failure) => [
          { html: `<span class="badge">${escapeHtml(failure.category)}</span>` },
          {
            html:
              `${escapeHtml(failure.fullTitle)}<br />${code(failure.file)}` +
              (failure.locator
                ? `<br /><span class="muted">Suggested locator (similarity ${failure.locator.score.toFixed(2)}, ${escapeHtml(failure.locator.confidence)}; review, not applied):</span> ${code(failure.locator.suggested)} <span class="muted">instead of</span> ${code(failure.locator.failed)}`
                : ''),
          },
          { html: failure.lastError ? code(failure.lastError) : '' },
        ]),
      )}`;
  const flaky =
    suite.flakyTests.length === 0
      ? ''
      : `<h4>Flaky tests</h4>
      <ul>${suite.flakyTests.map((title) => `<li>${escapeHtml(title)}</li>`).join('')}</ul>`;
  const clean = failures === '' && flaky === '' ? muted('No hard failures or flaky tests.') : '';
  const { stats } = suite;
  return `<article class="panel suite">
      <h3>${code(suite.suite)} <span class="${STATUS_TONE[suite.status]}">${escapeHtml(suite.status)}</span></h3>
      <p class="meta">${stats.expected} passed · ${stats.unexpected} hard fail · ${stats.flaky} flaky · ${stats.skipped} skipped</p>
      ${failures}${flaky}${clean}
    </article>`;
}

/** The same content as the PR comment, as a page to open locally. */
export function generateRunSummaryHtml(report: RunSummaryReport): string {
  const { totals } = report;
  const tone = STATUS_TONE[report.overallStatus];
  const body = [
    `<p class="overall status-${escapeHtml(report.overallStatus)}"><span class="${tone}">Overall: ${escapeHtml(report.overallStatus)}</span></p>`,
    section(
      'totals',
      'Totals',
      statTiles([
        { label: 'Passed', value: totals.expected, tone: 'good' },
        { label: 'Hard failures', value: totals.unexpected, tone: totals.unexpected > 0 ? 'bad' : 'neutral' },
        { label: 'Flaky', value: totals.flaky, tone: totals.flaky > 0 ? 'warn' : 'neutral' },
        { label: 'Skipped', value: totals.skipped },
      ]),
    ),
    section(
      'suites',
      'Suites',
      report.suites.length === 0 ? muted('No suite reports were provided.') : report.suites.map(htmlSuite).join('\n    '),
    ),
  ].join('\n\n    ');

  return htmlPage({
    title: report.title,
    testId: 'run-summary-report',
    heading: report.title,
    lede: `Merged from ${report.suites.length} suite report(s), generated ${report.generatedAt}. In CI the same summary is the sticky PR comment.`,
    body,
    extraStyles: `
    .overall { font-size: 1.25rem; font-weight: 700; margin: 0 0 0.5rem; }
    h4 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); margin: 0.9rem 0 0.35rem; }
`,
  });
}
