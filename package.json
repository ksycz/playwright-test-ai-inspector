{
  "name": "playwright-test-ai-inspector",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright tests with AI-assisted inspection",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "npm install && npm install --prefix app && npm run playwright:install",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers npx playwright install chromium",
    "dev": "npm run dev --prefix app",
    "build": "npm run build --prefix app",
    "preview": "npm run preview --prefix app",
    "test": "sh scripts/playwright.sh test",
    "test:smoke": "sh scripts/playwright.sh test --grep @smoke",
    "test:e2e": "sh scripts/playwright.sh test --grep @e2e --pass-with-no-tests",
    "test:api": "sh scripts/playwright.sh test --grep @api",
    "test:visual": "sh scripts/playwright.sh test --grep @visual",
    "test:ui": "sh scripts/playwright.sh test --ui",
    "test:headed": "sh scripts/playwright.sh test --headed",
    "test:ai": "node --experimental-strip-types --test ai/**/*.test.mts app/**/*.test.mts tests/reporters/**/*.test.mts scripts/**/*.test.mts scripts/mutation-spike/survivor.check.mts",
    "test:mutation": "stryker run",
    "analyze:failure": "node --experimental-strip-types ai/failure-analyzer/cli.mts",
    "analyze:report": "node --experimental-strip-types ai/failure-analyzer/report-cli.mts",
    "analyze:flaky": "node --experimental-strip-types ai/flaky-detector/cli.mts",
    "analyze:trends": "node --experimental-strip-types ai/failure-trends/cli.mts",
    "analyze:summary": "node --experimental-strip-types ai/run-summary/cli.mts",
    "analyze:locators": "node --experimental-strip-types ai/run-summary/locators-cli.mts",
    "analyze:deps": "node --experimental-strip-types ai/dep-gate/cli.mts",
    "analyze:review": "node --experimental-strip-types ai/pr-review/cli.mts",
    "tests:audit": "node --experimental-strip-types scripts/tests-audit.mts",
    "locator:eval": "node --experimental-strip-types ai/failure-analyzer/locator-eval-cli.mts",
    "explore": "node --experimental-strip-types ai/explorer/cli.mts",
    "explore:eval": "node --experimental-strip-types ai/explorer/eval-cli.mts",
    "explore:draft": "node --experimental-strip-types ai/explorer/draft-cli.mts",
    "report": "playwright show-report playwright-report",
    "trace": "playwright show-trace"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/mcp": "0.0.84",
    "@playwright/test": "^1.57.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/tap-runner": "^10.1.1",
    "@types/node": "^26.0.0"
  }
}
