{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "tap",
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "incremental": true,
  "tap": {
    "testFiles": [
      "ai/**/*.test.mts",
      "app/**/*.test.mts",
      "tests/reporters/**/*.test.mts",
      "scripts/**/*.test.mts"
    ],
    "nodeArgs": [
      "--experimental-strip-types",
      "--test-reporter=tap",
      "-r",
      "{{hookFile}}",
      "{{testFile}}"
    ]
  },
  "mutate": [
    "ai/shared/redact.mts",
    "ai/shared/markdown.mts",
    "ai/shared/pathContainment.mts",
    "ai/shared/cliArgs.mts",
    "ai/shared/html.mts",
    "ai/dep-gate/gate.mts",
    "ai/failure-analyzer/classify.mts",
    "ai/failure-analyzer/locator.mts",
    "ai/failure-analyzer/locator-tiebreak.mts",
    "ai/failure-analyzer/locator-eval.mts",
    "ai/failure-analyzer/suggest.mts",
    "ai/flaky-detector/analyze.mts",
    "ai/explorer/snapshot.mts",
    "ai/explorer/oracles.mts",
    "ai/explorer/charters.mts",
    "ai/explorer/evaluate.mts",
    "ai/explorer/draft.mts"
  ],
  "reporters": ["html", "clear-text", "progress", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "ignorePatterns": [".cursor", ".playwright-browsers", "playwright-report", "test-results", "ai-reports", "reports", "notes"],
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 47
  }
}
